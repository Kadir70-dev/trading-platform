# ==========================================================
# Exness MT5 Automated Trading Platform — Environment
# Copy to .env and fill in. NEVER commit the real .env.
# ==========================================================

# ---- Broker / Account ----
BROKER=EXNESS
ACCOUNT_MODE=DEMO          # DEMO | REAL

MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=Exness-MT5Trial15
MT5_PATH=                  # Path to terminal64.exe (Wine), optional

LEVERAGE=2000              # Expected leverage; verified against broker at startup

# ---- Trading ----
SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY
DEFAULT_SYMBOL=XAUUSD
TIMEFRAME=M1               # M1 | M5 | M15 | M30 | H1
DEFAULT_LOT=0.01
MAGIC_NUMBER=20260630

# ---- Risk Management ----
MAX_RISK_PCT=1.0           # Max risk per trade (% of equity)
MIN_RR=2.0                 # Minimum reward:risk
MAX_DAILY_LOSS_PCT=5.0     # Halt trading for the day past this loss
MAX_DRAWDOWN_PCT=20.0      # Emergency stop past this peak-to-trough drawdown
MAX_OPEN_TRADES=5
MAX_SYMBOL_EXPOSURE=2      # Max simultaneous positions per symbol
MAX_SPREAD_POINTS=50       # Reject trades when spread exceeds this (points)
EMERGENCY_STOP=false       # Hard kill switch — close all & stop when true

# ---- Strategy ----
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_BUY_LEVEL=50
RSI_SELL_LEVEL=50
SL_ATR_MULT=1.5            # Stop distance = SL_ATR_MULT * ATR
TP_RR=2.0                  # TP distance = TP_RR * SL distance

# ---- Service Endpoints ----
PYTHON_SERVICE_ADDR=127.0.0.1:8800     # FastAPI MT5/strategy service
CPP_GATEWAY_ADDR=127.0.0.1:8900        # C++ execution gateway
GO_HTTP_ADDR=127.0.0.1:8080            # Go health/metrics

# ---- Database ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_pw
DATABASE_URL=postgres://trader:trader_pw@127.0.0.1:5432/trading?sslmode=disable

# ---- Logging ----
LOG_LEVEL=INFO             # DEBUG | INFO | WARN | ERROR
LOG_DIR=./logs
